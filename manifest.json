{
  "manifest_version": 3,
  "name": "Hasura SQL Storer",
  "version": "1.0",
  "permissions": ["storage"],
"content_scripts": [
  {
    "matches": ["https://cloud.hasura.io/project/*/console/data/sql"],
    "js": [
      "sql-formatter.js",
      "content.js"
    ],
    "run_at": "document_idle"
  }
],
  "action": {
    "default_popup": "index.html",
    "default_icon": "brain.png"
  }
}
